{
  "name": "my-craft-demo",
  "version": "1.0.0",
  "private": true,
  "description": "我的世界 · 方块乐园 — 体素注意力训练游戏（原生 JS + Three.js，无构建步骤。本文件只承载开发期 lint 工具链，运行时不依赖 node_modules：入口 node server.js，浏览器直引 js/*.js）",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "lint": "eslint . && stylelint \"css/**/*.css\" && htmlhint index.html",
    "lint:fix": "eslint . --fix && stylelint \"css/**/*.css\" --fix"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "eslint-config-google": "^0.14.0",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.13.0",
    "htmlhint": "^1.9.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
