# EditorConfig: https://editorconfig.org
# 规范正文见 docs/conventions.md —— 空白/行尾/编码归这里管，引号/排版归 eslint、stylelint
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,mjs,cjs,css,html}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false   # Markdown 行尾双空格是换行语法
